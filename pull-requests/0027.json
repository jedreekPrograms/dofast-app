      "gists_url": "https://api.github.com/users/jedreekPrograms/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/jedreekPrograms/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/jedreekPrograms/subscriptions",
      "organizations_url": "https://api.github.com/users/jedreekPrograms/orgs",
